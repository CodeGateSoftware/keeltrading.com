# Node / package management
node_modules/
.pnpm-store/

# Build output
dist/
build/
.astro/

# Fetched-at-build artifacts (engine docs, releases, discussions) — never hand-copied
src/content/engine-docs/
src/content/changelog/
data/

# Cloudflare tooling
.wrangler/

# Environment — never commit secrets (Discussions read token, API keys)
.env
.env.*

# OS / editor noise
.DS_Store
*.swp

# Agent worktrees and session scratch. keel ignores this too; without it a `git add -A`
# in the shared checkout sweeps another session's worktree into your commit.
.claude/

---
import { localePath, locales, type Locale, type PageKey } from "../i18n/config";
import { t, localeNames } from "../i18n/ui";
import { ENGINE_URL } from "../i18n/config";

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;
const chrome = t(locale);

const navItems: { key: Exclude<PageKey, "home">; label: string }[] = [
  { key: "features", label: chrome.nav.features },
  { key: "install", label: chrome.nav.install },
  { key: "docs", label: chrome.nav.docs },
  { key: "news", label: chrome.nav.news },
  { key: "changelog", label: chrome.nav.changelog },
  { key: "community", label: chrome.nav.community },
  { key: "compliance", label: chrome.nav.compliance },
  { key: "compare", label: chrome.nav.compare },
  { key: "about", label: chrome.nav.about },
];

const menuLabel = locale === "ar" ? "القائمة" : locale === "fr" ? "Menu" : "Menu";

/** Compact codes next to the globe glyph; native names live in aria-label/title. */
const localeCodes: Record<Locale, string> = { en: "EN", ar: "AR", fr: "FR" };
---

<!-- First header — the invocation alone, centered on its own band (variant C:
     gold ink + flanking eight-pointed-star rules, all original geometry) -->
<div class="invocation-header" lang="ar" dir="rtl">
  <svg width="0" height="0" aria-hidden="true">
    <defs>
      <linearGradient id="inv-gold" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color: var(--gold-1)"></stop>
        <stop offset="0.45" style="stop-color: var(--gold-2)"></stop>
        <stop offset="0.6" style="stop-color: var(--gold-3)"></stop>
        <stop offset="1" style="stop-color: var(--gold-4)"></stop>
      </linearGradient>
    </defs>
  </svg>
  <div class="container">
    <div class="invocation-row">
      <svg class="invocation-orn" viewBox="0 0 120 24" aria-hidden="true">
        <line x1="0" y1="12" x2="44" y2="12" stroke="url(#inv-gold)" stroke-width="1.2"></line>
        <path
          transform="translate(60 12)"
          d="M0 -9 L3.5 -3.5 L9 0 L3.5 3.5 L0 9 L-3.5 3.5 L-9 0 L-3.5 -3.5 Z"
          fill="url(#inv-gold)"></path>
        <circle cx="60" cy="12" r="1.8" fill="url(#inv-gold)"></circle>
        <line x1="76" y1="12" x2="120" y2="12" stroke="url(#inv-gold)" stroke-width="1.2"></line>
      </svg>
      <p class="invocation invocation-gold">﴿وَقُلْ رَبِّ زِدْنِي عِلْمًا ١١٤﴾</p>
      <svg class="invocation-orn" viewBox="0 0 120 24" aria-hidden="true">
        <line x1="0" y1="12" x2="44" y2="12" stroke="url(#inv-gold)" stroke-width="1.2"></line>
        <path
          transform="translate(60 12)"
          d="M0 -9 L3.5 -3.5 L9 0 L3.5 3.5 L0 9 L-3.5 3.5 L-9 0 L-3.5 -3.5 Z"
          fill="url(#inv-gold)"></path>
        <circle cx="60" cy="12" r="1.8" fill="url(#inv-gold)"></circle>
        <line x1="76" y1="12" x2="120" y2="12" stroke="url(#inv-gold)" stroke-width="1.2"></line>
      </svg>
    </div>
    <p class="invocation-cite" dir="auto" lang={locale}>{
      locale === "ar" ? "[طه:114]" : "[Tā-Hā 114]"
    }</p>
  </div>
</div>

<!-- Second header — logo, name, and menu in one bar -->
<header class="site-header">
  <div class="container inner">
    <input type="checkbox" id="nav-toggle" class="nav-toggle visually-hidden-checkbox" aria-label={menuLabel} />
    <label class="hamburger" for="nav-toggle" aria-hidden="true">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <a class="brand" href={localePath(locale, "home")} aria-label="keel">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2v13M12 2l-4 5M12 2l4 5M12 15c-5 0-8 2.2-9.5 6h19C20 17.2 17 15 12 15Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        ></path>
      </svg>
      <span>keel</span>
    </a>

    <nav class="site-nav" aria-label={locale === "ar" ? "التنقّل الرئيسي" : "Main navigation"}>
      {
        navItems.map((item) => (
          <a
            href={localePath(locale, item.key)}
            aria-current={pageKey === item.key ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="nav-panel-langs">
        {
          locales
            .filter((candidate) => candidate !== locale)
            .map((other) => (
              <a href={pageKey ? localePath(other, pageKey) : `/${other}/`} lang={other}>
                {localeNames[other]}
              </a>
            ))
        }
      </div>
    </nav>

    <div class="header-actions">
      <div class="locale-menu">
        <p class="locale-switch" title={chrome.localeSwitcher.label}>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path
              d="M12 3a14.5 14.5 0 0 1 3.8 9A14.5 14.5 0 0 1 12 21a14.5 14.5 0 0 1-3.8-9A14.5 14.5 0 0 1 12 3Z"
            ></path>
          </svg>
          {localeCodes[locale]}
          <span class="locale-caret" aria-hidden="true">▾</span>
        </p>
        <ul class="locale-list" aria-label={chrome.localeSwitcher.label}>
          {
            locales
              .filter((candidate) => candidate !== locale)
              .map((other) => (
                <li>
                  <a
                    href={pageKey ? localePath(other, pageKey) : `/${other}/`}
                    lang={other}
                  >
                    {localeNames[other]}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label={locale === "ar"
          ? "تبديل بين الوضع النهاري والليلي"
          : locale === "fr"
            ? "Basculer entre le thème clair et le thème sombre"
            : "Toggle light and dark theme"}
      >
        <svg
          class="icon-sun"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <line x1="12" y1="2.5" x2="12" y2="5"></line>
          <line x1="12" y1="19" x2="12" y2="21.5"></line>
          <line x1="2.5" y1="12" x2="5" y2="12"></line>
          <line x1="19" y1="12" x2="21.5" y2="12"></line>
          <line x1="5.3" y1="5.3" x2="7" y2="7"></line>
          <line x1="17" y1="17" x2="18.7" y2="18.7"></line>
          <line x1="5.3" y1="18.7" x2="7" y2="17"></line>
          <line x1="17" y1="7" x2="18.7" y2="5.3"></line>
        </svg>
        <svg
          class="icon-moon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.2 13.2A8.2 8.2 0 1 1 10.8 3.8a6.5 6.5 0 0 0 9.4 9.4Z"></path>
        </svg>
      </button>
      <a
        class="github-link"
        href={ENGINE_URL}
        aria-label={chrome.actions.viewOnGitHub}
        title={chrome.actions.viewOnGitHub}
      >
        <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

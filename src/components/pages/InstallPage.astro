---
import Base from "../../layouts/Base.astro";
import ForOperators from "../ForOperators.astro";
import CodeBlock from "../CodeBlock.astro";
import { readDataFile } from "../docs/nav";
import { engineBlobUrl } from "../../lib/engine-url";
import { install } from "../../i18n/pages/install";
import { alternatesFor, formatDate, localePath, type Locale } from "../../i18n/config";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = install[locale];
const chrome = t(locale);

interface ReleaseData {
  tag: string | null;
  name: string | null;
  url: string;
  publishedAt: string | null;
  assets: { name: string; url: string; size: number }[];
  fetchedAt: string | null;
}
const release: ReleaseData =
  readDataFile<ReleaseData>("release.json") ?? {
    tag: null,
    name: null,
    url: "https://github.com/CodeGateSoftware/keel/releases/latest",
    publishedAt: null,
    assets: [],
    fetchedAt: null,
  };

const version = release.tag?.replace(/^v/, "") ?? null;

/**
 * FR-6 + milestone-ready: if the release ever carries platform bundles
 * (darwin/macos · dmg/pkg, windows · exe/msi/zip), the card button targets
 * them directly; otherwise it targets the release page (all wheels).
 */
const platformAsset = (patterns: string[]) =>
  release.assets.find((asset) => patterns.some((pattern) => asset.name.includes(pattern)));

const macAsset = platformAsset(["darwin", "macos", ".dmg", ".pkg"]);
const winAsset = platformAsset(["windows", "win32", "win64", ".exe", ".msi", ".zip"]);
/**
 * #97 — patch releases ship wheels only, so the desktop bundles live in the
 * newest release that carries them. When the latest is wheel-only, the cards
 * deep-link THAT release's assets, labeled with its version; pip and the
 * installer stay on the latest. The split is stated, not implied.
 */
const platformRelease = release.platformRelease ?? null;
const platformAssetFrom = (patterns: string[]) =>
  platformRelease?.assets.find((asset) =>
    patterns.some((pattern) => asset.name.includes(pattern)),
  ) ?? null;
const cardMac = macAsset ?? platformAssetFrom(["darwin", "macos", ".dmg", ".pkg"]);
const cardWin = winAsset ?? platformAssetFrom(["windows", "win32", "win64", ".exe", ".msi", ".zip"]);
const cardTargets = [cardMac, cardWin];
const desktopLags = Boolean(!macAsset && !winAsset && (cardMac || cardWin));
const desktopVersion = desktopLags ? (platformRelease?.tag ?? "").replace(/^v/, "") : version;

/**
 * Whether this release ships anything an operating system will refuse to open. Gates the
 * unsigned-build note: the wheels are not signed either, but pip does not warn about them, so a
 * Gatekeeper explanation shown beside a wheels-only release would be a warning about nothing.
 */
const hasPlatformBundle = Boolean(macAsset || winAsset);

const venvCommands = (os: "mac" | "win"): string => {
  const whl = "keel_trader-" + (version ?? "<version>") + "-py3-none-any.whl";
  if (os === "mac") {
    return [
      "mkdir keel && cd keel",
      "python3 -m venv .venv && source .venv/bin/activate",
      "pip install --find-links . ./" + whl,
      "keel versions",
    ].join("\n");
  }
  return [
    "mkdir keel; cd keel",
    "py -m venv .venv; .\\.venv\\Scripts\\Activate.ps1",
    "pip install --find-links . .\\" + whl,
    "keel versions",
  ].join("\n");
};

/**
 * keel's terminal installer (#86). The script is served from the DEFAULT BRANCH — it has
 * never been part of a tagged release — so the URL is pinned to main deliberately, and
 * c.terminal.branchNote says so on the page rather than letting the URL imply a version.
 *
 * Two blocks, always together: the pipe, and the download-read-run variant. A reader here
 * is being asked to hand keel exchange API keys, so `curl … | bash` is never offered alone.
 * The audit comment is localized and sits on its own line rather than trailing the command,
 * so the Arabic build does not have to interleave RTL prose inside an LTR command line.
 */
const INSTALLER_URL = "https://raw.githubusercontent.com/CodeGateSoftware/keel/main/scripts/install.sh";

const terminalPipeCommand = `curl -fsSL ${INSTALLER_URL} | bash`;

const terminalAuditCommands = [
  `curl -fsSL ${INSTALLER_URL} -o install.sh`,
  c.terminal.auditComment,
  "less install.sh",
  "bash install.sh",
].join("\n");

/**
 * Run by path, not by bare `keel`: the installer's own closing lines do the same, because
 * nothing is added to PATH unless the reader activates the venv themselves.
 */
const terminalUpdateCommands = [
  "cd ~/.keel",
  "./.venv/bin/keel update --check",
  "./.venv/bin/keel update",
].join("\n");

const fromSourceCommands = [
  "git clone https://github.com/CodeGateSoftware/keel.git && cd keel",
  "uv sync --all-extras --dev        # Python 3.14+ — the repo's floor moved up in #546",
  "cp .env.example .env              # put the read-only CDP key/secret in it — market data only",
  "uv run keel rules seed            # register the rule families as candidates",
  "uv run keel fetch                 # pull candle history for the default allowlist",
  "uv run keel simulate --years 1 --skip-within-cap",
].join("\n");
---

<Base
  locale={locale}
  pageKey="install"
  title={c.title}
  description={c.description}
  path={localePath(locale, "install")}
  alternates={alternatesFor("install")}
>
  <div class="container">
    <section class="hero">
      <h1>{c.downloadTitle}</h1>
      <p class="version-line">
        {
          release.tag ? (
            <>
              <span class="version-chip">{release.tag}</span>
              {release.publishedAt && <span class="version-date">{formatDate(release.publishedAt)}</span>}
            </>
          ) : (
            <a href={release.url}>{chrome.install.unknown}</a>
          )
        }
      </p>
      <p class="requirements">{c.requirements}</p>
      <p class="requirements">
        <a href={localePath(locale, "changelog")}>{c.historyLink}</a>
      </p>

      <div class="download-grid">
        {
          c.cards.map((card, index) => {
            const os = index === 0 ? "mac" : "win";
            const target = cardTargets[index] ?? null;
            return (
              <div class="download-card">
                <span class="platform-icon" aria-hidden="true">
                  {os === "mac" ? (
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                    </svg>
                  ) : (
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.351L0 20.699M10.949 12.6H24V24l-12.9-1.801" />
                    </svg>
                  )}
                </span>
                <h2>{card.name}</h2>
                <a class="button download-button" href={target?.url ?? release.url}>
                  {card.button}
                </a>
                {target && <span class="direct-file">{target.name}</span>}
                {desktopLags && desktopVersion && (
                  <span class="direct-file">{c.desktopLags.replace("{v}", desktopVersion).replace("{lv}", version ?? "")}</span>
                )}
                <div class="platform-steps">
                  <p class="shell-name">{card.shell}</p>
                  <CodeBlock code={card.codeComment + "\n" + venvCommands(os)} locale={locale} />
                </div>
              </div>
            );
          })
        }
      </div>

      <p class="other-platforms">
        {c.otherPlatforms} <a href={release.url}>{chrome.actions.seeReleases} →</a>
      </p>
    </section>

    <div class="narrow prose">
      {/* Placed FIRST, ahead of the release-file list and the from-source path: a reader who
          already has a terminal should meet the one-command road before the wheels-by-hand
          ceremony, not after it. The from-source section stays last — it is for people who
          want the repository, not the release. */}
      <section id="terminal-install">
        <h2>{c.terminal.title}</h2>
        <p>{c.terminal.lead}</p>
        <p>{c.terminal.terms}</p>
        <p>{c.terminal.requires}</p>

        <h3>{c.terminal.pipeTitle}</h3>
        <CodeBlock code={terminalPipeCommand} locale={locale} />

        <h3>{c.terminal.auditTitle}</h3>
        <p>{c.terminal.auditLead}</p>
        <CodeBlock code={terminalAuditCommands} locale={locale} />

        <p>{c.terminal.branchNote}</p>

        <h3>{c.terminal.doesTitle}</h3>
        <ul>{c.terminal.does.map((item) => <li>{item}</li>)}</ul>

        <h3>{c.terminal.updateTitle}</h3>
        <p>{c.terminal.updateBody}</p>
        <CodeBlock code={terminalUpdateCommands} locale={locale} />
      </section>

      {
        /*
         * Shown ONLY when the release actually carries a platform bundle. Until one exists there
         * is nothing for an operating system to warn about, and a note about Gatekeeper beside a
         * page that only offers wheels would be a warning about nothing.
         */
        hasPlatformBundle && (
          <section class="unsigned-note" role="note">
            <h2>{c.unsigned.title}</h2>

            {/* FIRST, before any of the certificate explanation. Someone reading this is deciding
                whether to proceed past a security warning, and "there is a route with no warning
                at all" is the most useful thing to hand them at that exact moment -- not four
                paragraphs about what Apple charges. It is honest about the trade rather than
                selling it: that route needs a terminal, which is the friction the desktop app
                exists to remove. */}
            <div class="unsigned-first">
              <h3>{c.unsigned.avoidTitle}</h3>
              <p>{c.unsigned.avoidBody}</p>
              <p><a class="button" href="#from-source">{c.unsigned.avoidLink} →</a></p>
            </div>

            <p>{c.unsigned.lead}</p>
            <p><strong>{c.unsigned.reason}</strong></p>

            {/* Stacked, not columned: the steps are long enough now that two columns would put
                step 6 of one beside step 2 of the other and read as one list. */}
            <h3>{c.unsigned.macosTitle}</h3>
            <ol>{c.unsigned.macosSteps.map((step) => <li>{step}</li>)}</ol>
            <h3>{c.unsigned.windowsTitle}</h3>
            <ol>{c.unsigned.windowsSteps.map((step) => <li>{step}</li>)}</ol>

            <h3>{c.unsigned.verifyTitle}</h3>
            <p>{c.unsigned.verifyLead}</p>
            <CodeBlock
              preClass="verify-command"
              code="gh attestation verify <the file you downloaded> --repo CodeGateSoftware/keel"
              locale={locale}
            />
            <p><strong>{c.unsigned.verifyFail}</strong></p>

            <h3>{c.unsigned.notMeaningTitle}</h3>
            <ul>{c.unsigned.notMeaning.map((item) => <li>{item}</li>)}</ul>

            <p>
              <a href={engineBlobUrl("docs/desktop-install.md")}>
                {c.unsigned.more} →
              </a>
            </p>
          </section>
        )
      }

      <section>
        <div class="stale-banner" role="note">
          <strong>{c.fromReleaseWarning}</strong>
        </div>
      </section>

      <section>
        <h2>{c.allFilesTitle}</h2>
        <ul class="asset-list">
          {
            release.assets.map((asset) => (
              <li>
                <a href={asset.url}>{asset.name}</a>
              </li>
            ))
          }
        </ul>
        <p class="never-mirror">
          {chrome.install.neverMirrored}
          {release.fetchedAt && ` ${chrome.install.copiedAtBuild(formatDate(release.fetchedAt))}`}
        </p>
      </section>

      <section class="operators-aside">
        <h2>{c.paperFirstTitle}</h2>
        <p>{c.paperFirstBody}</p>

        <h2>{c.getStarted.title}</h2>
        <p>{c.getStarted.body}</p>
        <p><a class="button" href={`${localePath("en", "guides")}first-run/`}>{c.getStarted.link} →</a></p>

        <h2>{c.browserTitle}</h2>
        <p>{c.browserBody}</p>
      </section>

      <section id="from-source">
        <h2>{c.fromSource.title}</h2>
        <p>{c.fromSource.lead}</p>
        <ul>
          {c.fromSource.requirements.map((requirement) => <li>{requirement}</li>)}
        </ul>
        <CodeBlock code={fromSourceCommands} locale={locale} />
        <h3>{c.fromSource.expectTitle}</h3>
        <p>{c.fromSource.expect}</p>
        <p>
          <a href={`${localePath("en", "docs")}go-live-runbook/`}>{c.fromSource.next} →</a>
        </p>
      </section>

      <ForOperators locale={locale} />
    </div>
  </div>
</Base>

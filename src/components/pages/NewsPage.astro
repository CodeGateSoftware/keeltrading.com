---
import Base from "../../layouts/Base.astro";
import { readDataFile } from "../docs/nav";
import { news } from "../../i18n/pages/news";
import { alternatesFor, formatDate, localePath, type Locale } from "../../i18n/config";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = news[locale];
const chrome = t(locale);

/** Email announcements (#65) — form renders only when the backend is wired. */
const subscriptionsEnabled = import.meta.env.PUBLIC_SUBSCRIPTIONS_ENABLED === "true";

interface DiscussionItem {
  number: number;
  title: string;
  url: string;
  createdAt: string;
  author: string | null;
  comments: number;
  excerpt: string;
}
interface DiscussionsFile {
  category: string;
  categoryUrl: string;
  fetchedAt: string | null;
  items: DiscussionItem[];
}

const feed: DiscussionsFile =
  readDataFile<DiscussionsFile>("discussions.json") ?? {
    category: "announcements",
    categoryUrl: "https://github.com/CodeGateSoftware/keel/discussions/categories/announcements",
    fetchedAt: null,
    items: [],
  };

/** Secondary feed (#13) — Show and tell; original language only (D4/D5). */
const showAndTell: DiscussionsFile =
  readDataFile<DiscussionsFile>("show-and-tell.json") ?? {
    category: "show-and-tell",
    categoryUrl: "https://github.com/CodeGateSoftware/keel/discussions/categories/show-and-tell",
    fetchedAt: null,
    items: [],
  };
---

<Base
  locale={locale}
  pageKey="news"
  title={c.title}
  description={c.description}
  path={localePath(locale, "news")}
  alternates={alternatesFor("news")}
>
  <div class="container">
    <section class="hero">
      <h1>{c.title}</h1>
      {c.intro.map((paragraph) => <p class="lede">{paragraph}</p>)}
    </section>

    <div class="narrow">
      <section aria-label={chrome.news.from}>
        {
          feed.fetchedAt && (
            <p class="doc-meta">{chrome.news.fetchedAt(formatDate(feed.fetchedAt))}</p>
          )
        }

        {
          feed.items.length === 0 ? (
            <div class="stale-banner" role="note">
              <p>{chrome.news.empty}</p>
              <p><a href={feed.categoryUrl}>{chrome.actions.readOnGitHub} →</a></p>
            </div>
          ) : (
            <ul class="news-list">
              {feed.items.map((item) => (
                <li class="news-item">
                  <p class="meta">
                    <time datetime={item.createdAt}>{formatDate(item.createdAt)}</time>
                    {item.author && (
                      <>
                        <span class="dot" aria-hidden="true">·</span>
                        <span>{item.author}</span>
                      </>
                    )}
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{chrome.news.comments(item.comments)}</span>
                  </p>
                  <p class="title">
                    <a href={item.url}>{item.title}</a>
                  </p>
                  {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
                </li>
              ))}
            </ul>
          )
        }

        <p class="doc-meta">
          {chrome.news.interactOnGitHub}{" "}
          <a href="/en/news/rss.xml">
            {locale === "ar" ? "خلاصة RSS" : locale === "fr" ? "Flux RSS" : "RSS feed"} ↗
          </a>
        </p>
      </section>

      {
        subscriptionsEnabled && (
          <section class="subscribe" aria-label={c.subscribeTitle}>
            <h2>{c.subscribeTitle}</h2>
            <p>{c.subscribeBody}</p>
            <form class="subscribe-form" action="/api/subscribe" method="post">
              <input type="hidden" name="locale" value={locale} />
              <label class="visually-hidden" for="subscribe-email">
                {c.subscribeTitle}
              </label>
              <input
                id="subscribe-email"
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder={c.subscribePlaceholder}
              />
              <button class="button" type="submit">{c.subscribeButton}</button>
            </form>
            <p class="subscribe-privacy">{c.subscribePrivacy}</p>
          </section>
        )
      }

      <section class="prose" aria-label={chrome.news.secondary}>
        <h2>{c.secondaryTitle}</h2>
        <p>{c.secondaryBody}</p>

        {
          showAndTell.items.length === 0 ? (
            <div class="stale-banner" role="note">
              <p>{chrome.news.secondaryEmpty}</p>
              <p>
                <a href={showAndTell.categoryUrl}>{chrome.actions.readOnGitHub} →</a>
              </p>
            </div>
          ) : (
            <ul class="news-list secondary">
              {showAndTell.items.map((item) => (
                <li class="news-item">
                  <p class="meta">
                    <time datetime={item.createdAt}>{formatDate(item.createdAt)}</time>
                    {item.author && (
                      <>
                        <span class="dot" aria-hidden="true">·</span>
                        <span>{item.author}</span>
                      </>
                    )}
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{chrome.news.comments(item.comments)}</span>
                  </p>
                  <p class="title">
                    <a href={item.url}>{item.title}</a>
                  </p>
                  {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
                </li>
              ))}
            </ul>
          )
        }

        <p class="doc-meta">
          <a href={showAndTell.categoryUrl}>{chrome.actions.readOnGitHub} →</a>
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  /* Secondary feed (#13) — same chrome as the announcements list, smaller and quieter. */
  .news-list.secondary {
    margin-block: 1rem;
  }
  .news-list.secondary li {
    padding-block: 0.75rem;
  }
  .news-list.secondary .news-item .meta {
    font-size: 0.8rem;
  }
  .news-list.secondary .news-item .title {
    font-size: 0.98rem;
    font-weight: 500;
  }
  .news-list.secondary .news-item .excerpt {
    font-size: 0.9rem;
  }
</style>

<style>
  /* Email announcements (#65) — quiet card under the feed it mirrors. */
  .subscribe {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.4rem 1.5rem;
    margin-block: 2.5rem;
  }

  .subscribe h2 {
    margin: 0 0 0.5rem;
  }

  .subscribe > p {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .subscribe-form input[type="email"] {
    flex: 1 1 14rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    min-width: 0;
  }

  .subscribe-form input[type="email"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .subscribe-privacy {
    margin-top: 1rem !important;
    font-size: 0.82rem !important;
  }
</style>

---
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../docs/DocsSidebar.astro";
import { loadDocsMeta, sectionIconSvg, sectionLabel, type SectionId } from "../docs/nav";
import { docs } from "../../i18n/pages/docs";
import { alternatesFor, formatDate, localePath, type Locale } from "../../i18n/config";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = docs[locale];
const chrome = t(locale);

const meta = loadDocsMeta();
const fetchedDate = formatDate(meta.fetchedAt);

const sections: { id: SectionId; extra?: boolean }[] = [
  { id: "get-started", extra: true },
  { id: "guides" },
  { id: "reference" },
  { id: "research" },
];

const quickstart = {
  title:
    locale === "ar"
      ? "جرّب كيل في خمس دقائق"
      : locale === "fr"
        ? "Essayez keel en cinq minutes"
        : "Try keel in five minutes",
  description:
    locale === "ar"
      ? "مسارٌ بصلاحية القراءة فقط على جانب التداول التجريبي: لا أموال، ولا أوامرَ تداول."
      : locale === "fr"
        ? "Un parcours en lecture seule, côté papier : aucun fonds, aucun ordre possible."
        : "A read-only, paper-side path: no funds, nothing can place an order.",
  href: localePath(locale, "install"),
};
---

<Base
  locale={locale}
  pageKey="docs"
  title={c.title}
  description={c.description}
  path={localePath(locale, "docs")}
  alternates={alternatesFor("docs")}
>
  <div class="container">
    <div class="docs-layout">
      <DocsSidebar locale={locale} />

      <div class="docs-content">
        <section class="hero">
          <h1>{c.title}</h1>
          {c.intro.map((paragraph) => <p class="lede">{paragraph}</p>)}
        </section>

        <p class="doc-meta">
          {chrome.docs.fetchedFrom(meta.repo, meta.ref)}
          {fetchedDate && ` ${chrome.docs.fetchedAt(fetchedDate)}`}
        </p>

        <div class="prose">
          <h2>{c.howTitle}</h2>
          {c.how.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {
          c.editionNoteTitle && c.editionNote.length > 0 && (
            <section class="prose">
              <h2>{c.editionNoteTitle}</h2>
              {c.editionNote.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          )
        }

        {
          sections.map(({ id: sectionId, extra }) => {
            const section = meta.sections.find((s) => s.id === sectionId);
            if (!section) return null;
            const sectionDocs = meta.docs.filter((doc) => doc.section === sectionId);
            return (
              <section class="docs-section" aria-labelledby={`sec-${sectionId}`}>
                <h2 id={`sec-${sectionId}`} class="docs-section-title">
                  <span class="docs-side-icon" set:html={sectionIconSvg(sectionId)} />
                  {sectionLabel(section, locale)}
                </h2>
                <ul class="docs-card-grid">
                  {extra && (
                    <li class="card arrow">
                      <a href={quickstart.href}>
                        <h3>{quickstart.title}</h3>
                        <p>{quickstart.description}</p>
                      </a>
                    </li>
                  )}
                  {sectionDocs.map((doc) => (
                    <li class="card arrow">
                      <a href={`${localePath("en", "docs")}${doc.slug}/`}>
                        <h3>{doc.title}</h3>
                        <p dir={locale === "ar" ? "rtl" : undefined}>
                          {locale === "ar" ? doc.ar : locale === "fr" ? doc.fr : doc.en}
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }

        {
          c.summaries && c.summaries.length > 0 && (
            <section class="prose">
              <h2>{c.summariesTitle}</h2>
              {c.summaries.map((summary) => {
                const original = meta.docs.find((doc) => doc.slug === summary.slug);
                return (
                  <div class="feature-section">
                    <h3>{summary.title}</h3>
                    {summary.body.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                    {original && (
                      <p>
                        <a href={`${localePath("en", "docs")}${original.slug}/`} lang="en">
                          {c.readOriginal} (EN) →
                        </a>
                      </p>
                    )}
                  </div>
                );
              })}
            </section>
          )
        }
      </div>
    </div>
  </div>
</Base>

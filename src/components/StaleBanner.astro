---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  englishPath: string;
}

const { locale, englishPath } = Astro.props;
const chrome = t(locale);
const banner = chrome.banner;
---

<div class="stale-banner" role="note">
  <strong>{banner.staleTitle}</strong>
  {banner.staleBody}
  <a href={englishPath} lang="en">{banner.staleLink} →</a>
</div>

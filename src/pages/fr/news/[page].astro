---
import NewsPage from "../../../components/pages/NewsPage.astro";
import { readDataFile } from "../../../components/docs/nav";
import type { Locale } from "../../../i18n/config";

export function getStaticPaths() {
  const feed = readDataFile<{ items: unknown[] }>("discussions.json");
  const totalPages = Math.max(1, Math.ceil((feed?.items.length ?? 0) / 5));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}
---
<NewsPage locale="fr" page={Number(Astro.params.page)} />
